+static int apple_z2_send_raw(struct apple_z2 *z2, const u8 *data, size_t size,
+			     u8 bits_per_word, bool send_ack)
+{
+	struct spi_message msg;
+	struct spi_transfer xfer[2] = {};
+
+	spi_message_init(&msg);
+	xfer[0].tx_buf = data;
+	xfer[0].len = size;
+	xfer[0].bits_per_word = bits_per_word;
+	spi_message_add_tail(&xfer[0], &msg);
+
+	z2->tx_buf[0] = 0x1a;
+	z2->tx_buf[1] = 0xa1;
+	if (send_ack) {
+		xfer[1].tx_buf = z2->tx_buf;
+		xfer[1].len = 2;
+		xfer[1].bits_per_word = bits_per_word;
+		spi_message_add_tail(&xfer[1], &msg);
+	}
+
+	return spi_sync(z2->spidev, &msg);
+}
+
+static const u8 *apple_z2_build_hbpp_blob(u32 address, const u8 *data,
+					  size_t data_size, size_t *size)
+{
+	size_t padded = round_up(data_size, 4);
+	size_t blob_size = sizeof(struct apple_z2_hbpp_blob_hdr) + padded + sizeof(u32);
+	u8 *blob __free(kfree) = kzalloc(blob_size, GFP_KERNEL);
+	struct apple_z2_hbpp_blob_hdr *hdr = (void *)blob;
+	u32 checksum = 0;
+	u16 header_checksum = 0;
+	size_t i;
+
+	if (!blob)
+		return ERR_PTR(-ENOMEM);
+
+	hdr->cmd = cpu_to_le16(APPLE_Z2_HBPP_CMD_BLOB);
+	hdr->len = cpu_to_le16(padded / 4);
+	hdr->addr = cpu_to_le32(address);
+	memcpy(blob + sizeof(*hdr), data, data_size);
+
+	for (i = 2; i < 8; i++)
+		header_checksum += blob[i];
+	hdr->checksum = cpu_to_le16(header_checksum);
+
+	for (i = 0; i < data_size; i++)
+		checksum += data[i];
+	put_unaligned_le32(checksum, blob + sizeof(*hdr) + padded);
+
+	*size = blob_size;
+	return no_free_ptr(blob);
+}
+
+static int apple_z2_upload_gen1(struct apple_z2 *z2, const u8 *firmware,
+				size_t firmware_size)
+{
+	static const u8 intro[] = {0x19, 0xc1};
+	static const u8 handshake[] = {
+		0x1a, 0xa1, 0x18, 0xe1, 0x18, 0xe1, 0x18, 0xe1,
+		0x18, 0xe1, 0x18, 0xe1, 0x18, 0xe1, 0x18, 0xe1,
+	};
+	static const struct {
+		u32 address;
+		u32 value;
+	} registers[] = {
+		{0x10003060, 6099},
+		{0x1000305c, 2},
+		{0x10003058, 6},
+		{0x10003000, 3},
+		{0x10003518, 1},
+	};
+	static const u8 request_calibration[] = {0x1f, 0x01};
+	static const u8 boot[] = {
+		0x1d, 0x53, 0x34, 0x00, 0x10, 0x00,
+		0x00, 0x01, 0x00, 0x00, 0x00, 0x45,
+	};
+	size_t ignored;
+	size_t i;
+	int error;
+
+	error = apple_z2_send_raw(z2, intro, sizeof(intro), 8, false);
+	if (error)
+		return error;
+
+	for (i = 0; i < 3; i++) {
+		error = apple_z2_send_raw(z2, handshake, sizeof(handshake), 8, false);
+		if (error)
+			return error;
+	}
+
+	if (device_property_present(&z2->spidev->dev, CAL_PROP_NAME)) {
+		const u8 *cal __free(kfree) =
+			apple_z2_build_cal_blob(z2, 0x10009000, &ignored);
+		if (IS_ERR(cal))
+			return PTR_ERR(cal);
+		if (cal) {
+			error = apple_z2_send_raw(z2, cal, ignored, 16, true);
+			if (error)
+				return error;
+		}
+	} else {
+		dev_warn(&z2->spidev->dev, "J85 calibration data is absent\n");
+	}
+
+	error = apple_z2_send_raw(z2, firmware, firmware_size, 16, true);
+	if (error)
+		return error;
+
+	for (i = 0; i < ARRAY_SIZE(registers); i++) {
+		u8 value[4] __aligned(4);
+		const u8 *packet __free(kfree);
+
+		put_unaligned_le32(registers[i].value, value);
+		packet = apple_z2_build_hbpp_blob(registers[i].address, value,
+						   sizeof(value), &ignored);
+		if (IS_ERR(packet))
+			return PTR_ERR(packet);
+
+		error = apple_z2_send_raw(z2, packet, ignored, 16, true);
+		if (error)
+			return error;
+	}
+
+	error = apple_z2_send_raw(z2, request_calibration,
+				  sizeof(request_calibration), 16, true);
+	if (error)
+		return error;
+
+	return apple_z2_send_raw(z2, boot, sizeof(boot), 16, false);
+}
+
+static bool apple_z2_is_gen1(struct spi_device *spi)
+{
+	const struct spi_device_id *id = spi_get_device_id(spi);
+
+	return id && !strcmp(id->name, "j85-multitouch");
+}
+
+static void apple_z2_gen1_reset_pulse(struct apple_z2 *z2, const char *stage)
+{
+	/* GPIO descriptors are polarity-aware: 1 asserts the active-low reset. */
+	gpiod_set_value(z2->reset_gpio, 1);
+	usleep_range(1000, 2000);
+	gpiod_set_value(z2->reset_gpio, 0);
+	usleep_range(1000, 2000);
+	dev_dbg(&z2->spidev->dev, "%s: reset pulse complete\n", stage);
+}
+
+static int apple_z2_gen1_zero_exchange(struct apple_z2 *z2, const char *stage)
+{
+	struct spi_transfer xfer = {};
+	int error;
+
+	memset(z2->tx_buf, 0, 4);
+	memset(z2->rx_buf, 0, 4);
+	xfer.tx_buf = z2->tx_buf;
+	xfer.rx_buf = z2->rx_buf;
+	xfer.len = 4;
+
+	error = spi_sync_transfer(z2->spidev, &xfer, 1);
+	if (error) {
+		dev_err(&z2->spidev->dev,
+			"%s: four-byte zero exchange failed: %d\n", stage, error);
+		return error;
+	}
+
+	usleep_range(1000, 2000);
+	dev_info(&z2->spidev->dev,
+		 "%s: zero exchange rx=%02x %02x %02x %02x\n",
+		 stage, z2->rx_buf[0], z2->rx_buf[1],
+		 z2->rx_buf[2], z2->rx_buf[3]);
+	return 0;
+}
